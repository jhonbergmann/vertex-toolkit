{
  "name": "vertex-toolkit",
  "version": "1.0.7",
  "description": "A comprehensive toolkit with validations, masks, formatters and utilities for React, React Native and Next.js applications",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "dev": "tsc --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "check": "npm run build && npm publish --dry-run",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "validation",
    "mask",
    "format",
    "cpf",
    "cnpj",
    "phone",
    "email",
    "date",
    "currency",
    "react",
    "react-native",
    "nextjs",
    "typescript",
    "toolkit",
    "utilities"
  ],
  "author": "Vertex",
  "license": "MIT",
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
